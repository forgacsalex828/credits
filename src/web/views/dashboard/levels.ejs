<%- include('../partials/header') %>
<h1>⭐ <%= guild.name %> – szintek</h1>
<p class="muted"><a href="/dashboard/<%= guild.id %>">← Beállítások</a></p>
<table class="table">
  <thead><tr><th>#</th><th>Felhasználó</th><th class="right">Szint</th><th class="right">XP</th><th class="right">Üzenetek</th></tr></thead>
  <tbody>
  <% rows.forEach((r, i) => { const m = guild.members.cache.get(r.user_id); %>
    <tr><td><%= i + 1 %></td><td><%= m ? m.displayName : r.user_id %></td><td class="right"><%= r.level %></td><td class="right"><%= r.xp %></td><td class="right"><%= r.messages %></td></tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="5" class="muted">Még senki nem szerzett XP-t.</td></tr><% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
