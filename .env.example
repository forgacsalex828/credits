# ===== Meteor bot beállításai =====

# --- Discord (kötelező) ---
# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=ide_a_bot_tokent
# Developer Portal → General Information → Application ID
CLIENT_ID=ide_az_application_id
# Developer Portal → OAuth2 → Client Secret (a weboldal bejelentkezéséhez kell)
CLIENT_SECRET=ide_a_client_secretet

# A bot tulajdonosainak Discord ID-ja vesszővel elválasztva. Csak ők használhatják az /admin parancsot.
OWNER_IDS=

# Opcionális: ha megadod, a parancsok csak erre a szerverre kerülnek fel (azonnal frissül, teszteléshez).
# Üresen hagyva GLOBÁLISAN regisztrálódnak (minden szerveren, kb. 1 óra alatt frissül).
GUILD_ID=

# --- Gazdaság ---
DAILY_REWARD=100
STARTING_BALANCE=0
WORK_MIN=20
WORK_MAX=80
WORK_COOLDOWN_MIN=30
MAX_BET=5000

# --- Weboldal ---
WEB_ENABLED=true
PORT=3000
# A nyilvános cím, ahol a weboldal elérhető. Ugyanezt + /callback kell felvenni a
# Developer Portal → OAuth2 → Redirects listába, pl. https://meteor.example.com/callback
BASE_URL=http://localhost:3000
# Véletlen, legalább 16 karakteres titok a sütik aláírásához. Generálás: openssl rand -hex 32
SESSION_SECRET=
# true, ha reverse proxy (nginx, Railway, Render) mögött fut, hogy a rate limit a valódi IP-t lássa
TRUST_PROXY=false
