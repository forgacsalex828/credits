# Meteor bot beállításai
# A Discord Developer Portal -> Bot oldalon található token
DISCORD_TOKEN=ide_a_bot_tokent
# Application ID (General Information oldal)
CLIENT_ID=ide_az_application_id

# Opcionális: ha megadod, a parancsok csak erre a szerverre kerülnek fel (azonnal frissül, teszteléshez jó).
# Ha üresen hagyod, GLOBÁLISAN regisztrálódnak (minden szerveren, kb. 1 óra alatt frissül).
GUILD_ID=

# Opcionális: a napi jutalom mérete és az induló egyenleg
DAILY_REWARD=100
STARTING_BALANCE=0
